{
  "name": "mountain-weather-tracker",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "prettier --check package.json svelte.config.js vite.config.ts tsconfig.json \"src/**/*.{svelte,ts}\"",
    "format": "prettier --write package.json svelte.config.js vite.config.ts tsconfig.json \"src/**/*.{svelte,ts}\"",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.48.5",
    "better-sqlite3": "^12.5.0",
    "drizzle-orm": "^0.45.0",
    "svelte": "^5.38.7",
    "vite": "^7.1.12"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.6.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.1",
    "drizzle-kit": "^0.31.8",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
